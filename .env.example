# ------------------------------------------------------------------
# Servicio API (apps/api)
# ------------------------------------------------------------------
# Puerto de escucha. Railway lo inyecta automaticamente (no definir).
# PORT=8787

# Secreto HMAC-SHA256 del Guardian determinista. DEFINIR en produccion;
# si falta, se usa "acme-eval-secret" (inseguro, solo para demo local).
GUARDIAN_HMAC_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Origenes permitidos para CORS, separados por coma.
# Si no se define, SOLO se permiten los origenes locales de Vite
# (localhost:5173 / 127.0.0.1:5173); nunca se refleja un origen arbitrario.
# En despliegue de un solo servicio no hace falta (mismo origen).
# CORS_ORIGIN=https://tu-web.up.railway.app

# Token requerido en el header `x-approvals-token` para aprobar/rechazar
# facturas escaladas. Sin definir, la cola humana queda abierta (solo demo).
# APPROVALS_TOKEN=un-token-largo-y-aleatorio

# Pon a "1" para que el Guardian exija GUARDIAN_HMAC_SECRET y falle si falta.
# GUARDIAN_REQUIRE_SECRET=0

# ------------------------------------------------------------------
# Servicio Web (apps/web) — SOLO si se despliega aparte de la API
# ------------------------------------------------------------------
# URL publica de la API. Se inyecta en tiempo de BUILD (Vite la embebe).
# Sin definir, la web llama a /api en su propio origen (servicio unico).
# VITE_API_URL=https://tu-api.up.railway.app
